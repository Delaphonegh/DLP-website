---
import type { Product } from "../data/products";
interface Props { product: Product }
const { product } = Astro.props;
---
<div class:list={["specific-mock", product.tone]}>
  {product.slug === "convoagent" && <>
    <div class="wa-mock-head"><span>◉</span><div><b>AccraBank Support</b><small>● Powered by ConvoAgent</small></div></div>
    <div class="wa-mock-body"><p>Hi Ama! How can I help today?</p><p>I need to pay my electricity bill</p><p>Sure. Your ECG bill is <b>GHS 142.00</b>. Pay from your MoMo wallet?</p><p>Yes please</p><p>Enter your MoMo PIN to confirm ✓</p></div>
    <div class="mock-pill left">● Resolved in 47 seconds</div>
  </>}
  {product.slug === "salesai" && <>
    <div class="dashboard-head"><div><b>This week&apos;s pipeline</b><small>Auto-generated by SalesAI</small></div><em>● 12 meetings booked</em></div>
    <div class="dashboard-stats"><div><b>347</b><small>Prospects contacted</small></div><div><b>89</b><small>Responded</small></div><div><b>12</b><small>Meetings booked</small></div></div>
    <div class="meeting-list"><small>BOOKED THIS WEEK</small><div><i>KO</i><span><b>Kojo Osei · TechSpring Ghana</b><small>Thu 10:00 · discovery call</small></span><em>Hot</em></div><div><i>AN</i><span><b>Adjoa Nkrumah · PayMax Fintech</b><small>Fri 14:30 · product demo</small></span><em>Warm</em></div><div><i>MB</i><span><b>Michael Boateng · Volta Insurance</b><small>Next Mon 09:00 · exec intro</small></span><em>Hot</em></div></div>
    <div class="mock-pill right">● All done overnight</div>
  </>}
  {product.slug === "campaignai" && <>
    <div class="dashboard-head"><div><b>Q4 Loan Promotion</b><small>Multi-channel · sent to 12,400 contacts</small></div><em>● Live</em></div>
    <div class="campaign-list"><small>CHANNEL PERFORMANCE</small><div><i>WA</i><span><b>WhatsApp</b><em>98% delivered · 34% clicked</em><u style="--progress:88%"></u></span></div><div><i>SMS</i><span><b>SMS</b><em>99% delivered · 12% clicked</em><u style="--progress:74%"></u></span></div><div><i>*#</i><span><b>USSD</b><em>100% reach · 8% dialled</em><u style="--progress:58%"></u></span></div></div>
    <div class="campaign-foot"><span>Applications this campaign<b>1,847</b></span><span>Cost per lead<b>GHS 2.14</b></span></div><div class="mock-pill right orange">● 3 channels · one dashboard</div>
  </>}
  {product.slug === "trustid" && <>
    <div class="dashboard-head"><div><b>Identity verification</b><small>Session #IV-284739</small></div><em>● Verified · 42 sec</em></div>
    <div class="verify-list">{[["Ghana Card scanned","GHA-284937241-4 · Ama Kwesi","3.1s"],["NIA record matched","Name, DOB, and photo confirmed","1.8s"],["Selfie liveness passed","Face match: 98.7% · liveness: confirmed","14.6s"],["Risk screening clear","PEP · sanctions · watchlists","22.5s"]].map(([title,copy,time]) => <div><i>✓</i><span><b>{title}</b><small>{copy}</small></span><em>{time}</em></div>)}</div>
    <div class="verify-foot"><span>Audit trail: available</span><b>● DPC-registered</b></div><div class="mock-pill left blue">● Under 60 seconds</div>
  </>}
  {product.slug === "spider-crm" && <>
    <div class="record-head"><i>AK</i><span><b>Ama Kwesi</b><small>Acme Manufacturing · Kumasi</small></span><em>● Active</em></div>
    <div class="record-tabs"><b>Timeline</b><span>Overview</span><span>Deals</span><span>Docs</span></div>
    <div class="record-list">{[["WA","WhatsApp","“When can we schedule the site visit?”","2 min ago"],["☎","Voice call · Kwadwo M.","Transcript ready · discussed pricing tiers","2h ago"],["✉","Email","Re: Quote for Q1 supply agreement","Yesterday"],["IG","Instagram DM","Initial enquiry via product post","3 days ago"]].map(([icon,title,copy,time]) => <div><i>{icon}</i><span><b>{title}</b><small>{copy}</small></span><em>{time}</em></div>)}</div>
    <div class="mock-pill right">● One customer · one thread</div>
  </>}
  {product.slug === "bizpilot" && <>
    <div class="dashboard-head"><div><b>Today&apos;s operations</b><small>Prepared by BizPilot</small></div><em>● Up to date</em></div>
    <div class="verify-list">{[["Quote prepared","Acme Manufacturing · GHS 18,500","Ready"],["Site visit scheduled","Friday · 10:30 AM","Booked"],["Invoices followed up","7 customers contacted","Done"],["Team summary drafted","Sales and service overview","Ready"]].map(([title,copy,time]) => <div><i>✓</i><span><b>{title}</b><small>{copy}</small></span><em>{time}</em></div>)}</div>
    <div class="mock-pill left coral">● Routine work handled</div>
  </>}
</div>
